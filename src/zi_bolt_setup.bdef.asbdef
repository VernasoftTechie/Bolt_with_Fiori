managed with additional save implementation in class zbp_i_bolt_setup unique;
strict ( 2 );

define behavior for ZI_BOLT_SETUP alias Setup
persistent table zbolt_setup
lock master
authorization master ( global )
{
  internal create;
  update;

  field ( readonly ) SetupId, GhStatus, GhStatusText, GhCheckedAt, AiKeySet, AiStatus, AiStatusText, AiCheckedAt,
                     CreatedBy, CreatedAt, ChangedBy, ChangedAt, LocalLastChanged;

  static action initialize result [1] $self;
  action testGitHub result [1] $self;
  action testAi result [1] $self;
  action setAiKey parameter ZA_BOLT_SECRET_P result [1] $self;

  mapping for zbolt_setup
  {
    SetupId          = setup_id;
    CustomerName     = customer_name;
    GhDestination    = gh_destination;
    GhOwner          = gh_owner;
    GhRepo           = gh_repo;
    GhBaseBranch     = gh_base_branch;
    GhBranchPrefix   = gh_branch_prefix;
    GhStatus         = gh_status;
    GhStatusText     = gh_status_text;
    GhCheckedAt      = gh_checked_at;
    AiProvider       = ai_provider;
    AiModel          = ai_model;
    AiDestination    = ai_destination;
    AiBasePath       = ai_base_path;
    AiMaxTokens      = ai_max_tokens;
    AiKeySet         = ai_key_set;
    AiStatus         = ai_status;
    AiStatusText     = ai_status_text;
    AiCheckedAt      = ai_checked_at;
    FormPrefix1      = form_prefix1;
    FormPrefix2      = form_prefix2;
    CountVolume      = count_volume;
    AdminUsers       = admin_users;
    CreatedBy        = created_by;
    CreatedAt        = created_at;
    ChangedBy        = changed_by;
    ChangedAt        = changed_at;
    LocalLastChanged = local_last_changed;
  }
}
