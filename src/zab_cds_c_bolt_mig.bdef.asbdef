projection;
strict ( 2 );

define behavior for ZAB_CDS_C_BOLT_MIG alias Migration
use etag
{
  use action commitSelection;
  use action refreshAll;
  use action pushToGitHub;
  use action refreshStatus;
  use action respond;
  use action requestStop;
  use action resume;
  use action saveLegacyDocs;
  use action aiSummary;

  use association _History;
  use association _File;
}

define behavior for ZAB_CDS_C_BOLT_HIST alias History
use etag
{
  use association _Migration;
}

define behavior for ZAB_CDS_C_BOLT_FILE alias File
use etag
{
  use association _Migration;
}
