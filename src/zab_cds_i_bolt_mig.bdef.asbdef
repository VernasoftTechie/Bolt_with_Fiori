managed implementation in class zbp_ab_bolt_mig unique;
strict ( 2 );

// Migrations are created and changed only by the actions below (internal
// create/update): commitSelection creates them from the Smart Forms tab, every
// other action talks to GitHub through ZCL_AB_BOLT_MIG_SVC and stores the
// basic status here. Communication texts stay on the branch (never stored).

define behavior for ZAB_CDS_I_BOLT_MIG alias Migration
persistent table zabt_bolt_mig
lock master
authorization master ( global )
etag master LocalChanged
{
  internal create;
  internal update;

  field ( numbering : managed, readonly ) MigUuid;
  field ( readonly ) SerialNo, FormName, FormDescr, DevPackage, DriverProgs, OutputTypes, RunNo, ReprocessOf,
                     Superseded, BranchName, FormSlug, PushStatus, PushMsg, PushAttempts, PushedAt, FilesCount,
                     CommitSha, MigStatus, WaitingOn, Stopped, ClaimedBy, StatusUpdated, StatusSha, LastSyncAt,
                     PickedUpAt, StoppedAt, CompletedAt, Complexity, ComplexityInfo, SourceSysid, SourceClient,
                     CreatedBy, CreatedAt, ChangedBy, ChangedAt, LocalChanged;

  static action commitSelection parameter ZAB_CDS_A_BOLT_COMMIT_P result [0..*] $self;
  static action refreshAll result [0..*] $self;

  action pushToGitHub result [1] $self;
  action refreshStatus result [1] $self;
  action respond parameter ZAB_CDS_A_BOLT_RESP_P result [1] $self;
  action requestStop parameter ZAB_CDS_A_BOLT_STOP_P result [1] $self;
  action resume result [1] $self;
  action saveLegacyDocs parameter ZAB_CDS_A_BOLT_DOCS_P result [1] $self;
  action aiSummary result [1] ZAB_CDS_A_BOLT_TEXT_R;

  association _History { internal create; }
  association _File { internal create; }

  mapping for zabt_bolt_mig
  {
    MigUuid        = mig_uuid;
    SerialNo       = serial_no;
    FormName       = form_name;
    FormDescr      = form_descr;
    DevPackage     = dev_package;
    DriverProgs    = driver_progs;
    OutputTypes    = output_types;
    RunNo          = run_no;
    ReprocessOf    = reprocess_of;
    Superseded     = superseded;
    BranchName     = branch_name;
    FormSlug       = form_slug;
    PushStatus     = push_status;
    PushMsg        = push_msg;
    PushAttempts   = push_attempts;
    PushedAt       = pushed_at;
    FilesCount     = files_count;
    CommitSha      = commit_sha;
    MigStatus      = mig_status;
    WaitingOn      = waiting_on;
    Stopped        = stopped;
    ClaimedBy      = claimed_by;
    StatusUpdated  = status_updated;
    StatusSha      = status_sha;
    LastSyncAt     = last_sync_at;
    PickedUpAt     = picked_up_at;
    StoppedAt      = stopped_at;
    CompletedAt    = completed_at;
    Complexity     = complexity;
    ComplexityInfo = complexity_info;
    SourceSysid    = source_sysid;
    SourceClient   = source_client;
    CreatedBy      = created_by;
    CreatedAt      = created_at;
    ChangedBy      = changed_by;
    ChangedAt      = changed_at;
    LocalChanged   = local_changed;
  }
}

define behavior for ZAB_CDS_I_BOLT_HIST alias History
persistent table zabt_bolt_hist
lock dependent by _Migration
authorization dependent by _Migration
etag dependent by _Migration
{
  field ( numbering : managed, readonly ) HistUuid;
  field ( readonly ) MigUuid, EventAt, HistEvent, Actor, EventUser, MigStatus, WaitingOn, Stopped, CommitSha;

  association _Migration;

  mapping for zabt_bolt_hist
  {
    MigUuid   = mig_uuid;
    HistUuid  = hist_uuid;
    EventAt   = event_at;
    HistEvent = hist_event;
    Actor     = actor;
    EventUser = event_user;
    MigStatus = mig_status;
    WaitingOn = waiting_on;
    Stopped   = stopped;
    CommitSha = commit_sha;
  }
}

define behavior for ZAB_CDS_I_BOLT_FILE alias File
persistent table zabt_bolt_file
lock dependent by _Migration
authorization dependent by _Migration
etag dependent by _Migration
{
  internal update;

  field ( numbering : managed, readonly ) FileUuid;
  field ( readonly ) MigUuid, FileKind, FileName, FilePath, SizeBytes, CommitSha, PushedAt, PushedBy, Removed,
                     RemovedAt, RemovedBy;

  association _Migration;

  mapping for zabt_bolt_file
  {
    MigUuid   = mig_uuid;
    FileUuid  = file_uuid;
    FileKind  = file_kind;
    FileName  = file_name;
    FilePath  = file_path;
    SizeBytes = size_bytes;
    CommitSha = commit_sha;
    PushedAt  = pushed_at;
    PushedBy  = pushed_by;
    Removed   = removed;
    RemovedAt = removed_at;
    RemovedBy = removed_by;
  }
}
