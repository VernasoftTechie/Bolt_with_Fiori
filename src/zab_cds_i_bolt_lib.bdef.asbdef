managed implementation in class zbp_ab_bolt_lib unique;
strict ( 2 );

// Global reference library (logos, Smart Styles, naming standards, policies).
// upload pushes the files to <library folder>/<category folder>/ on the
// default branch and lists them here; delete only removes a file from this
// list (GitHub keeps it) - the same as the web app. Administrators only.

define behavior for ZAB_CDS_I_BOLT_LIB alias Library
persistent table zabt_bolt_lib
lock master
authorization master ( global )
etag master LocalChanged
{
  internal create;
  delete;

  field ( numbering : managed, readonly ) LibUuid;
  field ( readonly ) LibCategory, FileName, FilePath, SizeBytes, Provenance, Pushed, PushMsg, CommitSha,
                     CreatedBy, CreatedAt, ChangedBy, ChangedAt, LocalChanged;

  static action upload parameter ZAB_CDS_A_BOLT_LIB_P result [0..*] $self;

  mapping for zabt_bolt_lib
  {
    LibUuid      = lib_uuid;
    LibCategory  = lib_category;
    FileName     = file_name;
    FilePath     = file_path;
    SizeBytes    = size_bytes;
    Provenance   = provenance;
    Pushed       = pushed;
    PushMsg      = push_msg;
    CommitSha    = commit_sha;
    CreatedBy    = created_by;
    CreatedAt    = created_at;
    ChangedBy    = changed_by;
    ChangedAt    = changed_at;
    LocalChanged = local_changed;
  }
}
