managed implementation in class zbp_i_bolt_system unique;
strict ( 2 );

define behavior for ZI_BOLT_SYSTEM alias SourceSystem
persistent table zbolt_system
lock master
authorization master ( global )
{
  create;
  update;
  delete;

  field ( mandatory : create, readonly : update ) SystemId;
  field ( readonly ) Status, StatusText, CheckedAt, CreatedBy, CreatedAt, ChangedBy, ChangedAt, LocalLastChanged;

  action testConnection result [1] $self;

  mapping for zbolt_system
  {
    SystemId         = system_id;
    Description      = description;
    SapClient        = sap_client;
    Destination      = destination;
    ServicePath      = service_path;
    BaseUrl          = base_url;
    IsLocal          = is_local;
    IsDefault        = is_default;
    SortOrder        = sort_order;
    Status           = status;
    StatusText       = status_text;
    CheckedAt        = checked_at;
    CreatedBy        = created_by;
    CreatedAt        = created_at;
    ChangedBy        = changed_by;
    ChangedAt        = changed_at;
    LocalLastChanged = local_last_changed;
  }
}
