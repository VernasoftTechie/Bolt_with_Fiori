managed with additional save implementation in class zbp_ab_bolt_setup unique;
strict ( 2 );

// One row per system (SetupId DEFAULT), maintained on the Configuration tab.
// Changes are for Bolt administrators only (ADMIN_USERS; blank = first set-up).
// The GitHub token and the AI key go to ZABT_BOLT_SECRT in the saver and are
// never returned - only GhTokenSet / AiKeySet say that one is stored.

define behavior for ZAB_CDS_I_BOLT_SETUP alias Setup
persistent table zabt_bolt_setup
lock master
authorization master ( global )
etag master LocalChanged
{
  internal create;
  update;

  field ( readonly : update ) SetupId;
  field ( readonly ) GhTokenSet, GhLogin, GhUserName, GhScopes, GhConnectedAt, GhRepo, GhBaseBranch, GhBranchPfx,
                     GhPrivate, GhCanPush, GhCheckRes, GhCheckMsg, GhCheckedAt, AiProvider, AiModel, AiBaseUrl,
                     AiMaxTokens, AiKeySet, AiCheckRes, AiCheckMsg, AiCheckedAt, CreatedBy, CreatedAt, ChangedBy,
                     ChangedAt, LocalChanged;

  static action initialize result [1] $self;
  action connectGitHub parameter ZAB_CDS_A_BOLT_TOKEN_P result [1] $self;
  action disconnectGitHub result [1] $self;
  action checkRepo parameter ZAB_CDS_A_BOLT_REPO_P result [1] $self;
  action createRepo parameter ZAB_CDS_A_BOLT_REPO_P result [1] $self;
  action saveRepo parameter ZAB_CDS_A_BOLT_REPO_P result [1] $self;
  action saveAi parameter ZAB_CDS_A_BOLT_AI_P result [1] $self;
  action testAi parameter ZAB_CDS_A_BOLT_AI_P result [1] $self;

  validation checkSettings on save { create; update; }

  mapping for zabt_bolt_setup
  {
    SetupId       = setup_id;
    CustomerName  = customer_name;
    AdminUsers    = admin_users;
    GhApiUrl      = gh_api_url;
    GhDest        = gh_dest;
    SslId         = ssl_id;
    GhTokenSet    = gh_token_set;
    GhLogin       = gh_login;
    GhUserName    = gh_user_name;
    GhScopes      = gh_scopes;
    GhConnectedAt = gh_connected_at;
    GhRepo        = gh_repo;
    GhBaseBranch  = gh_base_branch;
    GhBranchPfx   = gh_branch_pfx;
    GhPrivate     = gh_private;
    GhCanPush     = gh_can_push;
    GhCheckRes    = gh_check_res;
    GhCheckMsg    = gh_check_msg;
    GhCheckedAt   = gh_checked_at;
    StatusFolder  = status_folder;
    LibFolder     = lib_folder;
    AiProvider    = ai_provider;
    AiModel       = ai_model;
    AiBaseUrl     = ai_base_url;
    AiDest        = ai_dest;
    AiMaxTokens   = ai_max_tokens;
    AiKeySet      = ai_key_set;
    AiCheckRes    = ai_check_res;
    AiCheckMsg    = ai_check_msg;
    AiCheckedAt   = ai_checked_at;
    FormPrefixes  = form_prefixes;
    CountVolume   = count_volume;
    CreatedBy     = created_by;
    CreatedAt     = created_at;
    ChangedBy     = changed_by;
    ChangedAt     = changed_at;
    LocalChanged  = local_changed;
  }
}
