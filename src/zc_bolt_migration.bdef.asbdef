projection;
strict ( 2 );

define behavior for ZC_BOLT_MIGRATION alias Migration
{
  use action commitSelection;
  use action refreshAll;
  use action importFromGitHub;
  use action pushToGitHub;
  use action refreshStatus;
  use action confirmManual;
  use action raiseConcern;
  use action setStop;
  use action addReferenceFile;
  use action withdraw;
  use action aiSummary;

  use association _Log;
  use association _File;
}

define behavior for ZC_BOLT_MIGLOG alias MigrationLog
{
  use association _Migration;
}

define behavior for ZC_BOLT_MIGFILE alias MigrationFile
{
  use association _Migration;
}
