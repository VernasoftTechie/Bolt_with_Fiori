{
  "_version": "1.58.0",
  "sap.app": {
    "id": "vernasoft.boltfiori",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "2.1.1"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zab_ui_bolt_o4/srvd/sap/zab_ui_bolt/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "boltMigration-manage": {
          "semanticObject": "BoltMigration",
          "action": "manage",
          "title": "{{appTitle}}",
          "subTitle": "{{appSubTitle}}",
          "icon": "sap-icon://journey-change",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://journey-change"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": false
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "rootView": {
      "viewName": "vernasoft.boltfiori.view.App",
      "type": "XML",
      "id": "app",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ui.unified": {},
        "sap.ui.export": {
          "lazy": true
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "vernasoft.boltfiori.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "odata": {
        "dataSource": "mainService",
        "preload": false,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": false,
          "earlyRequests": false
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "path": "vernasoft.boltfiori.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "setup",
          "pattern": "setup",
          "target": "setup"
        },
        {
          "name": "help",
          "pattern": "help/:section:",
          "target": "help"
        },
        {
          "name": "detail",
          "pattern": "migration/{migUuid}",
          "target": "detail"
        },
        {
          "name": "dashboard",
          "pattern": ":tab:",
          "target": "dashboard"
        }
      ],
      "targets": {
        "dashboard": {
          "viewName": "Dashboard",
          "viewId": "dashboard",
          "viewLevel": 1
        },
        "setup": {
          "viewName": "Setup",
          "viewId": "setup",
          "viewLevel": 2
        },
        "help": {
          "viewName": "Help",
          "viewId": "help",
          "viewLevel": 2
        },
        "detail": {
          "viewName": "Detail",
          "viewId": "detail",
          "viewLevel": 2
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "vernasoft-boltfiori"
  }
}
