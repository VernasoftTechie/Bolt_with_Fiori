<mvc:View
  controllerName="vernasoft.boltfiori.controller.Dashboard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  height="100%"
  displayBlock="true">

  <!-- Left: the process, in its order - 1 select Smart Forms, 2 drafts (not on
       GitHub yet), 3 migrations. Right: Setup (every prerequisite with its
       status) and Help. Each number is shown once. No system selection: the
       Smart Forms are those of the system the app runs in. -->
  <Page id="page" class="boltPage" showHeader="true" enableScrolling="true">
    <customHeader>
      <Bar class="boltTopBar">
        <contentLeft>
          <core:Icon src="sap-icon://journey-change" class="boltBrandIcon"/>
          <Title text="{i18n>appTitle}" level="H1" class="boltBrand"/>
          <Text text="{app>/setup/CustomerName}" class="boltCustomer" visible="{= !!${app>/setup/CustomerName} }"/>
        </contentLeft>
        <contentRight>
          <Button icon="sap-icon://refresh" tooltip="{i18n>refreshAll}" press=".onRefreshAll" type="Transparent"/>
        </contentRight>
      </Bar>
    </customHeader>

    <content>
      <!-- A backend problem shows here; everything else still loads. -->
      <MessageStrip visible="{= !!${app>/sysError} }" type="Error" showIcon="true" class="sapUiSmallMargin"
                    text="{= ${i18n>sysErrorStrip} + ' ' + ${app>/sysError} }"/>
      <MessageStrip visible="{= !!${app>/setupError} }" type="Error" showIcon="true" class="sapUiSmallMargin"
                    text="{= ${i18n>setupErrorStrip} + ' ' + ${app>/setupError} }"/>

      <FlexBox wrap="Wrap" alignItems="Start" class="boltLayout">

        <!-- ================================ PROCESS (left) ================================ -->
        <VBox class="boltMain">
          <IconTabBar id="tabs" selectedKey="{view>/tab}" select=".onTabSelect" expandable="false" headerMode="Inline"
                      applyContentPadding="false" class="boltProcessTabs" stretchContentHeight="false">
            <items>

              <!-- 1. Select Smart Forms -->
              <IconTabFilter key="forms" text="{i18n>stepForms}">
                <SegmentedButton class="boltFilterBar" selectedKey="{view>/formFilter}" selectionChange=".onFormFilter">
                  <items>
                    <SegmentedButtonItem key="all" text="{= ${i18n>filterAll} + ' ' + ${view>/counts/formsAll} }"/>
                    <SegmentedButtonItem key="available" text="{= ${i18n>filterAvailable} + ' ' + ${view>/counts/formsAvailable} }"/>
                    <SegmentedButtonItem key="ACTIVE" text="{= ${i18n>filterInMigration} + ' ' + ${view>/counts/formsActive} }"/>
                    <SegmentedButtonItem key="STOPPED" text="{= ${i18n>filterStopped} + ' ' + ${view>/counts/formsStopped} }"/>
                    <SegmentedButtonItem key="COMPLETED" text="{= ${i18n>filterCompleted} + ' ' + ${view>/counts/formsCompleted} }"/>
                  </items>
                </SegmentedButton>
                <OverflowToolbar class="boltToolbar">
                  <SearchField value="{view>/search}" liveChange=".onFormSearch" width="22rem" placeholder="{i18n>searchForms}"/>
                  <ToolbarSpacer/>
                  <Button icon="sap-icon://excel-attachment" tooltip="{i18n>exportForms}" press=".onExportForms" type="Transparent"/>
                  <Button text="{= ${view>/selectedCount} > 0 ? ${i18n>next} + ' (' + ${view>/selectedCount} + ')' : ${i18n>next} }"
                          type="Emphasized" icon="sap-icon://navigation-right-arrow" iconFirst="false"
                          enabled="{= ${view>/selectedCount} > 0 }"
                          tooltip="{= ${app>/ready/all} ? ${i18n>nextTip} : ${i18n>nextDraftTip} }"
                          press=".onNext">
                    <layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
                  </Button>
                </OverflowToolbar>
                <Text text="{i18n>formsHint}" class="boltHint boltStepHint"/>
                <MessageStrip visible="{= !!${view>/formsError} }" text="{view>/formsError}" type="Error" showIcon="true"
                              class="sapUiSmallMarginBottom"/>

                <Table id="formsTable" mode="MultiSelect" items="{path: 'view>/formsShown', templateShareable: false}"
                       rememberSelections="false" growing="true" growingThreshold="100" growingScrollToLoad="true"
                       busy="{view>/formsBusy}" busyIndicatorDelay="0" selectionChange=".onFormSelect" sticky="ColumnHeaders"
                       class="boltTable">
                  <noData>
                    <IllustratedMessage illustrationType="sapIllus-NoSearchResults" title="{i18n>noFormsTitle}"
                                        description="{i18n>noForms}" enableVerticalResponsiveness="true"/>
                  </noData>
                  <columns>
                    <Column><Text text="{i18n>colForm}"/></Column>
                    <Column width="7rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colPackage}"/></Column>
                    <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colPrinting}"/></Column>
                    <Column width="8rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colChanged}"/></Column>
                    <Column width="14rem"><Text text="{i18n>colMigration}"/></Column>
                  </columns>
                  <items>
                    <ColumnListItem selected="{view>selected}" type="Inactive"
                                    highlight="{= ${view>MigState} === 'ACTIVE' ? 'Information' : (${view>MigState} === 'STOPPED' ? 'Warning' : (${view>MigState} === 'COMPLETED' ? 'Success' : 'None')) }">
                      <cells>
                        <ObjectIdentifier title="{view>FormName}" text="{view>Description}"/>
                        <Text text="{view>DevPackage}"/>
                        <VBox>
                          <Text text="{view>DriverProgs}" maxLines="1" tooltip="{view>DriverProgs}"/>
                          <Text text="{view>OutputTypes}" maxLines="1" tooltip="{view>OutputTypes}" class="boltMuted"/>
                        </VBox>
                        <VBox>
                          <Text text="{path: 'view>ChangedOn', formatter: '.formatter.date'}"/>
                          <Text text="{view>ChangedBy}" class="boltMuted"/>
                        </VBox>
                        <ObjectStatus text="{parts: ['view>MigState', 'view>LastSerialNo', 'view>LastStatus', 'view>LastRunNo'], formatter: '.formatter.formStateText'}"
                                      state="{path: 'view>MigState', formatter: '.formatter.formStateState'}"
                                      active="{= ${view>MigState} !== 'NONE' }" press=".onOpenMigrationFromForm"/>
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </IconTabFilter>

              <!-- 2. Drafts: committed, initial load not on GitHub yet -->
              <IconTabFilter key="drafts" text="{i18n>stepDrafts}" count="{= ${view>/counts/drafts} > 0 ? String(${view>/counts/drafts}) : '' }"
                             iconColor="{= ${view>/counts/drafts} > 0 ? 'Critical' : 'Default' }">
                <OverflowToolbar class="boltToolbar">
                  <ToolbarSpacer/>
                  <Button text="{i18n>sendAllDrafts}" icon="sap-icon://upload-to-cloud" type="Emphasized" press=".onSendAllDrafts"
                          enabled="{= ${view>/counts/drafts} > 0 &amp;&amp; !${view>/draftBusy} }"/>
                </OverflowToolbar>
                <Text text="{i18n>draftsHint}" class="boltHint boltStepHint"/>
                <MessageStrip visible="{= !${app>/ready/repo} &amp;&amp; ${view>/counts/drafts} > 0 }" type="Warning" showIcon="true"
                              text="{i18n>draftsNotReady}" class="sapUiSmallMarginBottom">
                  <link><Link text="{i18n>openSetup}" press=".onOpenSetup"/></link>
                </MessageStrip>
                <Table items="{path: 'view>/drafts', templateShareable: false}" busy="{view>/draftBusy}" busyIndicatorDelay="0"
                       sticky="ColumnHeaders" class="boltTable">
                  <noData>
                    <IllustratedMessage illustrationType="sapIllus-SuccessHighFive" title="{i18n>noDraftsTitle}"
                                        description="{i18n>noDrafts}" enableVerticalResponsiveness="true"/>
                  </noData>
                  <columns>
                    <Column width="5rem"><Text text="{i18n>colSerial}"/></Column>
                    <Column><Text text="{i18n>colForm}"/></Column>
                    <Column width="10rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colCommitted}"/></Column>
                    <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colLastAttempt}"/></Column>
                    <Column width="13rem" hAlign="End"><Text text=""/></Column>
                  </columns>
                  <items>
                    <ColumnListItem type="Navigation" press=".onMigrationPress"
                                    highlight="{= ${view>PushStatus} === 'FAILED' ? 'Error' : 'Information' }">
                      <cells>
                        <ObjectNumber number="{view>SerialNo}"/>
                        <ObjectIdentifier title="{view>FormName}" text="{view>FormDescr}"/>
                        <VBox>
                          <Text text="{path: 'view>CreatedAt', formatter: '.formatter.dateTime'}"/>
                          <Text text="{view>CreatedBy}" class="boltMuted"/>
                        </VBox>
                        <ObjectStatus text="{= ${view>PushStatus} === 'FAILED' ? ${view>PushMsg} : ${i18n>notSentYet} }"
                                      state="{= ${view>PushStatus} === 'FAILED' ? 'Error' : 'None' }"
                                      tooltip="{= ${i18n>attempts} + ' ' + ${view>PushAttempts} }"/>
                        <HBox justifyContent="End">
                          <Button text="{i18n>sendToGitHub}" icon="sap-icon://upload-to-cloud" press=".onSendDraft" type="Transparent"/>
                          <Button icon="sap-icon://delete" tooltip="{i18n>discardDraft}" press=".onDiscardDraft" type="Transparent"/>
                        </HBox>
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </IconTabFilter>

              <!-- 3. Migrations on GitHub -->
              <IconTabFilter key="migrations" text="{i18n>stepMigrations}"
                             count="{= ${view>/counts/needs} > 0 ? String(${view>/counts/needs}) : '' }"
                             iconColor="{= ${view>/counts/needs} > 0 ? 'Critical' : 'Default' }">
                <SegmentedButton class="boltFilterBar" selectedKey="{view>/migFilter}" selectionChange=".onMigrationFilter">
                  <items>
                    <SegmentedButtonItem key="all" text="{= ${i18n>filterAll} + ' ' + ${view>/counts/migAll} }"/>
                    <SegmentedButtonItem key="needs" text="{= ${i18n>filterNeedsMe} + ' ' + ${view>/counts/needs} }"/>
                    <SegmentedButtonItem key="active" text="{= ${i18n>filterActive} + ' ' + ${view>/counts/active} }"/>
                    <SegmentedButtonItem key="stopped" text="{= ${i18n>filterStopped} + ' ' + ${view>/counts/stopped} }"/>
                    <SegmentedButtonItem key="completed" text="{= ${i18n>filterCompleted} + ' ' + ${view>/counts/completed} }"/>
                  </items>
                </SegmentedButton>
                <OverflowToolbar class="boltToolbar">
                  <SearchField value="{view>/migSearch}" liveChange=".onMigrationSearch" width="22rem" placeholder="{i18n>searchMigrations}"/>
                  <ToolbarSpacer/>
                  <CheckBox text="{i18n>showReplaced}" selected="{view>/showReplaced}" select=".onMigrationFilter"/>
                  <Text text="{= ${view>/migReading} ? ${i18n>readingStatuses} : ${view>/lastRefreshText} }" class="boltMuted"/>
                  <Button icon="sap-icon://excel-attachment" tooltip="{i18n>exportMigrations}" press=".onExportMigrations" type="Transparent"/>
                  <Button text="{i18n>refreshStatuses}" icon="sap-icon://refresh" press=".onRefreshStatuses">
                    <layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
                  </Button>
                </OverflowToolbar>
                <Text text="{i18n>migrationsHint}" class="boltHint boltStepHint"/>

                <Table id="migrationTable" items="{path: 'view>/migrationsShown', templateShareable: false}"
                       busy="{view>/migBusy}" busyIndicatorDelay="0" growing="true" growingThreshold="50"
                       sticky="ColumnHeaders" class="boltTable">
                  <noData>
                    <IllustratedMessage illustrationType="sapIllus-EmptyList" title="{i18n>noMigrationsTitle}"
                                        description="{i18n>noMigrations}" enableVerticalResponsiveness="true"/>
                  </noData>
                  <columns>
                    <Column width="4rem"><Text text="{i18n>colSerial}"/></Column>
                    <Column><Text text="{i18n>colForm}"/></Column>
                    <Column width="13rem"><Text text="{i18n>colStatus}"/></Column>
                    <Column width="9rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colWaitingOn}"/></Column>
                    <Column width="6rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colComplexity}"/></Column>
                    <Column width="9rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colUpdated}"/></Column>
                  </columns>
                  <items>
                    <ColumnListItem type="Navigation" press=".onMigrationPress"
                                    highlight="{= ${view>needsClient} ? 'Warning' : 'None' }">
                      <cells>
                        <ObjectNumber number="{view>SerialNo}"/>
                        <ObjectIdentifier title="{view>FormName}" text="{= ${view>RunNo} > 1 ? ${view>BranchName} + ' · run ' + ${view>RunNo} : ${view>BranchName} }"/>
                        <ObjectStatus text="{view>statusText}" state="{view>statusState}"
                                      icon="{= ${view>isStopped} ? 'sap-icon://stop' : '' }"/>
                        <VBox>
                          <Text text="{view>waitingText}"/>
                          <Text text="{view>ClaimedBy}" class="boltMuted"/>
                        </VBox>
                        <ObjectStatus text="{path: 'view>Complexity', formatter: '.formatter.complexityText'}"
                                      state="{path: 'view>Complexity', formatter: '.formatter.complexityState'}"
                                      tooltip="{view>ComplexityInfo}"/>
                        <VBox>
                          <Text text="{path: 'view>StatusUpdated', formatter: '.formatter.dateTime'}"/>
                          <ObjectStatus text="{view>ageText}" state="{view>ageState}"/>
                        </VBox>
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </IconTabFilter>

            </items>
          </IconTabBar>
        </VBox>

        <!-- ================================ SETUP + HELP (right) ================================ -->
        <VBox class="boltSide">
          <VBox class="boltSideCard">
            <HBox justifyContent="SpaceBetween" alignItems="Center">
              <Title text="{i18n>setupTitle}" level="H3"/>
              <ObjectStatus text="{= ${app>/ready/all} ? ${i18n>live} : ${i18n>setupNeeded} }"
                            state="{= ${app>/ready/all} ? 'Success' : 'Error' }"
                            icon="sap-icon://circle-task-2" inverted="true" tooltip="{i18n>liveTip}" class="boltLive"/>
            </HBox>
            <List showSeparators="Inner" class="boltChecks">
              <CustomListItem>
                <HBox alignItems="Center" class="boltCheck">
                  <core:Icon src="sap-icon://it-system" class="boltCheckIcon" color="Positive"/>
                  <VBox>
                    <Text text="{i18n>chkSystem}" class="boltCheckLabel"/>
                    <Text text="{app>/sys/SystemId} · {i18n>client} {app>/sys/Client}"/>
                  </VBox>
                </HBox>
              </CustomListItem>
              <CustomListItem>
                <HBox alignItems="Center" class="boltCheck">
                  <core:Icon src="{= ${app>/ready/github} ? 'sap-icon://sys-enter-2' : 'sap-icon://error' }" class="boltCheckIcon"
                             color="{= ${app>/ready/github} ? 'Positive' : 'Negative' }"/>
                  <VBox>
                    <Text text="{i18n>chkGithub}" class="boltCheckLabel"/>
                    <Text text="{= ${app>/ready/github} ? ${i18n>connectedAs} + ' ' + ${app>/setup/GhLogin} : ${i18n>notConnected} }"/>
                  </VBox>
                </HBox>
              </CustomListItem>
              <CustomListItem>
                <HBox alignItems="Center" class="boltCheck">
                  <core:Icon src="{= ${app>/ready/repo} ? 'sap-icon://sys-enter-2' : 'sap-icon://error' }" class="boltCheckIcon"
                             color="{= ${app>/ready/repo} ? 'Positive' : 'Negative' }"/>
                  <VBox>
                    <Text text="{i18n>chkRepo}" class="boltCheckLabel"/>
                    <Text text="{= ${app>/setup/GhRepo} ? ${app>/setup/GhRepo} + (${app>/ready/repo} ? '' : ' · ' + ${i18n>noPush}) : ${i18n>notSet} }" wrapping="true"/>
                  </VBox>
                </HBox>
              </CustomListItem>
              <CustomListItem>
                <HBox alignItems="Center" class="boltCheck">
                  <core:Icon src="{= (${app>/setup/AiProvider} === 'mock' || !${app>/setup/AiProvider}) ? 'sap-icon://hint' : (${app>/ready/ai} &amp;&amp; ${app>/setup/AiCheckRes} !== 'ERROR' ? 'sap-icon://sys-enter-2' : 'sap-icon://error') }"
                             class="boltCheckIcon"
                             color="{= (${app>/setup/AiProvider} === 'mock' || !${app>/setup/AiProvider}) ? 'Default' : (${app>/ready/ai} &amp;&amp; ${app>/setup/AiCheckRes} !== 'ERROR' ? 'Positive' : 'Negative') }"/>
                  <VBox>
                    <Text text="{i18n>chkAi}" class="boltCheckLabel"/>
                    <Text text="{view>/aiText}"/>
                  </VBox>
                </HBox>
              </CustomListItem>
              <CustomListItem>
                <HBox alignItems="Center" class="boltCheck">
                  <core:Icon src="{= ${app>/sys/IndexBuilt} ? 'sap-icon://sys-enter-2' : 'sap-icon://warning' }" class="boltCheckIcon"
                             color="{= ${app>/sys/IndexBuilt} ? 'Positive' : 'Critical' }"/>
                  <VBox>
                    <Text text="{i18n>chkIndex}" class="boltCheckLabel"/>
                    <Text text="{= ${app>/sys/IndexBuilt} ? ${i18n>indexBuilt} : ${i18n>indexMissing} }" wrapping="true"/>
                  </VBox>
                </HBox>
              </CustomListItem>
              <CustomListItem>
                <HBox alignItems="Center" class="boltCheck">
                  <core:Icon src="{= ${app>/sys/AdminsDefined} ? 'sap-icon://sys-enter-2' : 'sap-icon://warning' }" class="boltCheckIcon"
                             color="{= ${app>/sys/AdminsDefined} ? 'Positive' : 'Critical' }"/>
                  <VBox>
                    <Text text="{i18n>chkAdmins}" class="boltCheckLabel"/>
                    <Text text="{= ${app>/sys/AdminsDefined} ? ${app>/setup/AdminUsers} : ${i18n>adminsMissing} }" wrapping="true"/>
                  </VBox>
                </HBox>
              </CustomListItem>
            </List>
            <Button text="{i18n>openSetup}" icon="sap-icon://action-settings" press=".onOpenSetup" width="100%"
                    type="{= ${app>/ready/all} ? 'Default' : 'Emphasized' }" class="sapUiSmallMarginTop"/>
          </VBox>

          <VBox class="boltSideCard">
            <Title text="{i18n>helpTitle}" level="H3"/>
            <Text text="{i18n>helpShort}" class="boltHint"/>
            <Button text="{i18n>openHelp}" icon="sap-icon://sys-help" press=".onOpenHelp" width="100%" class="sapUiSmallMarginTop"/>
            <Text text="{= ${i18n>version} + ' ' + (${app>/sys/AppVersion} || '') }" class="boltMuted sapUiTinyMarginTop"/>
          </VBox>
        </VBox>
      </FlexBox>
    </content>
  </Page>
</mvc:View>
