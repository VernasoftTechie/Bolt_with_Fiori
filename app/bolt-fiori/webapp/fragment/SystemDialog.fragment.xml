<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="systemDialog" title="{= ${view>/systemEdit/isNew} ? ${i18n>addSystem} : ${i18n>editSystem} }"
          contentWidth="34rem" draggable="true">
    <content>
      <VBox class="sapUiSmallMargin boltFields">
        <Label text="{i18n>sysId}" required="true" labelFor="sysId"/>
        <Input id="sysId" value="{view>/systemEdit/SystemId}" maxLength="10" editable="{view>/systemEdit/isNew}"
               placeholder="DEV, QA, PRD ..."/>
        <Label text="{i18n>colDescription}" labelFor="sysDescr"/>
        <Input id="sysDescr" value="{view>/systemEdit/Description}" maxLength="60"/>
        <CheckBox text="{i18n>sysLocal}" selected="{view>/systemEdit/local}"/>
        <Text text="{i18n>sysLocalHint}" class="boltHint"/>
        <Label text="{i18n>colClient}" labelFor="sysClient"/>
        <Input id="sysClient" value="{view>/systemEdit/SapClient}" maxLength="3" width="6rem" placeholder="100"/>
        <Label text="{i18n>sysDestination}" labelFor="sysDest" required="{= !${view>/systemEdit/local} }"/>
        <Input id="sysDest" value="{view>/systemEdit/Destination}" maxLength="32" enabled="{= !${view>/systemEdit/local} }"
               placeholder="e.g. ZBOLT_QA"/>
        <Label text="{i18n>sysPath}" labelFor="sysPath"/>
        <Input id="sysPath" value="{view>/systemEdit/ServicePath}" maxLength="255"/>
        <Label text="{i18n>sysUrl}" labelFor="sysUrl"/>
        <Input id="sysUrl" value="{view>/systemEdit/BaseUrl}" maxLength="255" placeholder="https://qa-host:44300"/>
        <Label text="{i18n>sysOrder}" labelFor="sysOrder"/>
        <StepInput id="sysOrder" value="{view>/systemEdit/SortOrder}" min="0" max="999" width="8rem"/>
        <CheckBox text="{i18n>sysDefault}" selected="{view>/systemEdit/default}"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="{i18n>save}" type="Emphasized" press=".onSaveSystem"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onCancelSystem"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
