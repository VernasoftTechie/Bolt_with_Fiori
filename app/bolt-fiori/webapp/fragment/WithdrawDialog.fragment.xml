<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="withdrawDialog" title="{i18n>withdrawTitle}" type="Message" state="Warning" contentWidth="30rem">
    <content>
      <VBox class="boltFields">
        <Text text="{i18n>withdrawText}"/>
        <MessageStrip visible="{d>/hasConfirmedWork}" type="Warning" showIcon="true" text="{i18n>withdrawConfirmedWork}"
                      class="sapUiTinyMarginTop"/>
        <Label text="{i18n>withdrawReason}" labelFor="withdrawReason" class="sapUiSmallMarginTop"/>
        <Input id="withdrawReason" value="{d>/withdraw/reason}"/>
        <CheckBox text="{i18n>withdrawDeleteBranch}" selected="{d>/withdraw/deleteBranch}"
                  visible="{= ${d>/PushStatus} === 'PUSHED' }"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="{= ${d>/withdraw/deleteBranch} ? ${i18n>withdrawAndDelete} : ${i18n>withdraw} }" type="Reject"
              press=".onWithdrawConfirm"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onWithdrawCancel"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
