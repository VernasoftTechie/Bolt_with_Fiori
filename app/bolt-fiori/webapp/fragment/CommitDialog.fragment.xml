<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <!-- Next > confirmation > Commit: each selected form becomes a migration with
       its own serial number, then its legacy files go to a new GitHub branch -
       one form after the other, each with its own live result. -->
  <Dialog id="commitDialog" title="{i18n>commitTitle}" contentWidth="44rem" draggable="true" resizable="true"
          escapeHandler=".onCloseCommit">
    <content>
      <VBox class="sapUiSmallMargin">
        <MessageStrip visible="{= !${view>/commit/committed} &amp;&amp; ${view>/commit/asDrafts} }" text="{i18n>commitDraftIntro}" type="Warning" showIcon="true"
                      class="sapUiSmallMarginBottom"/>
        <MessageStrip visible="{= !${view>/commit/committed} &amp;&amp; !${view>/commit/asDrafts} }" text="{i18n>commitIntro}" type="Information" showIcon="true"
                      class="sapUiSmallMarginBottom"/>
        <MessageStrip visible="{view>/commit/done}" text="{i18n>commitDone}" type="Success" showIcon="true"
                      class="sapUiSmallMarginBottom"/>
        <List items="{path: 'view>/commit/items', templateShareable: false}" busy="{= ${view>/commit/busy} &amp;&amp; !${view>/commit/committed} }"
              busyIndicatorDelay="0">
          <CustomListItem>
            <HBox alignItems="Center" class="sapUiSmallMarginBeginEnd sapUiTinyMarginTopBottom">
              <core:Icon src="{view>icon}" class="sapUiSmallMarginEnd" size="1.25rem"
                         color="{= ${view>state} === 'Success' ? 'Positive' : (${view>state} === 'Error' ? 'Negative' : 'Default') }"/>
              <VBox>
                <Title text="{view>FormName}" level="H4"/>
                <Text text="{view>Description}" class="boltMuted"/>
                <ObjectStatus text="{view>text}" state="{view>state}"/>
              </VBox>
            </HBox>
          </CustomListItem>
        </List>
      </VBox>
    </content>
    <beginButton>
      <Button text="{= ${view>/commit/asDrafts} ? ${i18n>saveAsDrafts} : ${i18n>commit} }" type="Emphasized" press=".onCommit"
              visible="{= !${view>/commit/committed} }" enabled="{= !${view>/commit/busy} }"/>
    </beginButton>
    <endButton>
      <Button text="{= ${view>/commit/done} ? ${i18n>close} : ${i18n>cancel} }" press=".onCloseCommit"
              enabled="{= !${view>/commit/busy} }"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
